# service.py reads deployment and storage paths from config/backend.json.
# Store generated secrets only in runtime/.secrets (chmod 600), never commit them.
CVW_INTERNAL_TOKEN=<generate-a-random-token-at-least-32-characters>
CVW_SESSION_SECRET=<generate-a-different-random-secret>
# Optional: pin the Node >=22 bin directory used by lifecycle commands.
# CVW_NODE_BIN=/path/to/node22/bin
# Worker selection when starting a bridge directly:
# CVW_WORKER_ID=cvw-codex-360
# Model endpoint/model are in config/backend.json and config/video_settings.json.
# Test credentials live in runtime/test-account.json; do not use an admin account.
